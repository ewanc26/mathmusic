    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
